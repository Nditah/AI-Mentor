NEXT_PUBLIC_API_URL=http://localhost:8000
# A production build refuses this. The public site has no session switcher.
NEXT_PUBLIC_DEV_AUTH=true
NEXT_PUBLIC_WWW_URL=http://localhost:3005
NEXT_PUBLIC_LEARNER_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_INSTRUCTOR_URL=http://localhost:3002
NEXT_PUBLIC_INSTITUTION_URL=http://localhost:3003
NEXT_PUBLIC_STUDIO_URL=http://localhost:3004
# Optional. When set, /login and /register use Clerk. Local DEV_AUTH continues to the Learner App.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
CSP_REPORT_ONLY=
