# Copy to backend/.env for local API runs. Docker Compose injects the service block itself.
# Production refuses to start unless every value marked "production" is set (app/core/config.py).
APP_ENV=development
DEV_AUTH=true
DATABASE_URL=postgresql+psycopg://mentor:mentor@localhost:5432/mentor

# Vector store. "memory" keeps vectors on the embeddings table with hash embeddings.
# An http(s) Qdrant URL needs OPENAI_API_KEY for real embeddings (SRS RAG-010).
# Production: an https:// URL and QDRANT_API_KEY.
QDRANT_URL=memory
QDRANT_API_KEY=

# Shared rate-limit counters. Production: required.
REDIS_URL=

# Origins allowed to call the API (studio and admin). Production: https only, no "*".
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Origins that billing may return to. Defaults to the first CORS origin.
STUDIO_ORIGINS=

# Clerk. Production: JWKS URL, issuer, and secret key are required.
CLERK_JWKS_URL=
CLERK_ISSUER=
# Expected `aud`, when your Clerk JWT template sets one.
CLERK_AUDIENCE=
# Accepted `azp` values. Defaults to CORS_ORIGINS.
CLERK_AUTHORIZED_PARTIES=
CLERK_WEBHOOK_SECRET=
# Used to delete the Clerk account when a learner deletes theirs.
CLERK_SECRET_KEY=
JWT_LEEWAY_SECONDS=5
# Staff sessions need a second factor. On by default in production and cannot be disabled there.
REQUIRE_STAFF_MFA=

# The code lab runs learner Python. Off by default in production and refused there
# until runs happen in an isolated runner with no secrets and no network.
LAB_ENABLED=
# Small-team exception to the four-eyes rule for publishing (Security-Compliance AZ-5).
CONTENT_SELF_APPROVAL=false

# Stripe. Checkout returns 503 until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_RESEARCH=

# Model providers. With none set, tutors still teach from the curriculum policy.
# Production: OPENAI_API_KEY is required for embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# OTLP/HTTP collector base URL; /v1/traces is appended.
OTEL_EXPORTER_OTLP_ENDPOINT=

# SEC-035: per user, plus a per-address ceiling for every request.
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_HOUR=10
ANONYMOUS_RATE_LIMIT_PER_MINUTE=120
