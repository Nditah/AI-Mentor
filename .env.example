# Copy to backend/.env for local API runs. Docker Compose injects the service block itself.
APP_ENV=development
DEV_AUTH=true
DATABASE_URL=postgresql+psycopg://mentor:mentor@localhost:5432/mentor
# Use "memory" to run without Qdrant. Compose sets the HTTP URL.
QDRANT_URL=memory
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Clerk. Required when APP_ENV=production. Leave empty to use the dev session switcher.
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# Stripe. Checkout returns 503 until these are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_RESEARCH=

# Model providers. With none set, tutors still teach from the curriculum policy.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=

RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=20
